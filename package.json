  "description": "![Preview](preview.png)",
  "main": "BlueprintLibrary.mod.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.js --bundle --outfile=BlueprintLibrary.mod.js --format=iife --define:IS_DEV=false",
