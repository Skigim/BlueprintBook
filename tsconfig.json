{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "strictNullChecks": true,
        "noImplicitAny": false,
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "lib/**/*.js", "src/types/*.d.ts"],
    "exclude": ["node_modules", "dist", "tests"]
}
